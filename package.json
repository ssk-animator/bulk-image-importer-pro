{
  "name": "bulk-image-importer-pro",
  "version": "1.0.0",
  "description": "Professional Excel add-in for bulk image import with advanced layout controls",
  "main": "dist/taskpane.html",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "start": "vite --config vite.config.ts",
    "lint": "tsc --noEmit",
    "validate": "node tools/validate-manifest.js manifest.production.xml && node tools/validate-manifest.js manifest.xml --assets src/assets",
    "validate:release": "node tools/validate-manifest.js release/manifest.xml",
    "sync-manifest": "node tools/sync-manifest.js",
    "sync-manifest:check": "node tools/sync-manifest.js --check",
    "release": "npm run lint && npm run build && npm run sync-manifest && npm run validate && npm run validate:release",
    "sideload:web": "powershell -NoProfile -ExecutionPolicy RemoteSigned -File tools/Launch-WebExcel-Importer.ps1",
    "certs:install": "npx office-addin-dev-certs install",
    "certs:verify": "npx office-addin-dev-certs verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/office-js": "^1.0.256",
    "office-addin-debugging": "^5.0.0",
    "office-addin-dev-certs": "^1.12.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
