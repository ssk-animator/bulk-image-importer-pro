                <Control xsi:type="Button" id="BulkImageImporter.Button.ContactSheet.Web">
                  <Label resid="ImportContactSheet.Label"/>
                  <Supertip>
                    <Title resid="ImportContactSheet.Label"/>
                    <Description resid="ImportContactSheet.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ImportContactSheet.Icon16"/>
                    <bt:Image size="32" resid="ImportContactSheet.Icon32"/>
                    <bt:Image size="80" resid="ImportContactSheet.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
