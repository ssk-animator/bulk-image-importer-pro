<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp"
>
  <Id>f6b7d875-25aa-469e-88ec-df2bf16318aa</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Bulk Image Importer Pro</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Bulk Image Importer Pro"/>
  <Description DefaultValue="Import hundreds of images into Excel with advanced layout controls. Supports row, column, grid, masonry, and contact sheet layouts."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/support"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_1"
  >
    <Hosts>
      <Host xsi:type="Workbook">

        <!-- Desktop: Full tab + FunctionFile for ExecuteFunction -->
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="BulkImageImporter.Tab">
              <Label resid="Tab.Label"/>
              <Group id="BulkImageImporter.Group.Import">
                <Label resid="ImportGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="ImportGroup.Icon16"/>
                  <bt:Image size="32" resid="ImportGroup.Icon32"/>
                  <bt:Image size="80" resid="ImportGroup.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="BulkImageImporter.Button.ImportImages">
                  <Label resid="ImportImages.Label"/>
                  <Supertip>
                    <Title resid="ImportImages.Label"/>
                    <Description resid="ImportImages.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ImportImages.Icon16"/>
                    <bt:Image size="32" resid="ImportImages.Icon32"/>
                    <bt:Image size="80" resid="ImportImages.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BulkImageImporter.Button.ImportFolder">
                  <Label resid="ImportFolder.Label"/>
                  <Supertip>
                    <Title resid="ImportFolder.Label"/>
                    <Description resid="ImportFolder.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ImportFolder.Icon16"/>
                    <bt:Image size="32" resid="ImportFolder.Icon32"/>
