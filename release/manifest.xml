                    <bt:Image size="32" resid="ImportRow.Icon32"/>
                    <bt:Image size="80" resid="ImportRow.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BulkImageImporter.Button.Column.Web">
                  <Label resid="ImportColumn.Label"/>
                  <Supertip>
                    <Title resid="ImportColumn.Label"/>
                    <Description resid="ImportColumn.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ImportColumn.Icon16"/>
                    <bt:Image size="32" resid="ImportColumn.Icon32"/>
                    <bt:Image size="80" resid="ImportColumn.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
