              </Group>
              <Group id="BulkImageImporter.Group.Layout">
                <Label resid="LayoutGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="LayoutGroup.Icon16"/>
                  <bt:Image size="32" resid="LayoutGroup.Icon32"/>
                  <bt:Image size="80" resid="LayoutGroup.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="BulkImageImporter.Button.Row">
                  <Label resid="ImportRow.Label"/>
                  <Supertip>
                    <Title resid="ImportRow.Label"/>
                    <Description resid="ImportRow.Description"/>
