                    <bt:Image size="32" resid="Settings.Icon32"/>
                    <bt:Image size="80" resid="Settings.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </CustomTab>
          </ExtensionPoint>
        </WebFormFactor>

      </Host>
