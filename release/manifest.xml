<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp"
>
  <Id>f6b7d875-25aa-469e-88ec-df2bf16318aa</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Bulk Image Importer Pro</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Bulk Image Importer Pro"/>
  <Description DefaultValue="Import hundreds of images into Excel with advanced layout controls. Supports row, column, grid, masonry, and contact sheet layouts."/>
  <IconUrl DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://bulk-image-importer-pro.pages.dev/support"/>

  <AppDomains>
    <AppDomain>https://bulk-image-importer-pro.pages.dev</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://bulk-image-importer-pro.pages.dev/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_1"
  >
    <Hosts>
      <Host xsi:type="Workbook">

        <!-- Desktop: Full tab + FunctionFile for ExecuteFunction -->
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="BulkImageImporter.Tab">
              <Label resid="Tab.Label"/>
              <Group id="BulkImageImporter.Group.Main">
                <Label resid="MainGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="MainGroup.Icon16"/>
                  <bt:Image size="32" resid="MainGroup.Icon32"/>
                  <bt:Image size="80" resid="MainGroup.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="BulkImageImporter.Button.Open">
                  <Label resid="OpenImporter.Label"/>
                  <Supertip>
                    <Title resid="OpenImporter.Label"/>
                    <Description resid="OpenImporter.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="OpenImporter.Icon16"/>
                    <bt:Image size="32" resid="OpenImporter.Icon32"/>
                    <bt:Image size="80" resid="OpenImporter.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BulkImageImporter.Button.Clear">
                  <Label resid="ClearImages.Label"/>
                  <Supertip>
                    <Title resid="ClearImages.Label"/>
                    <Description resid="ClearImages.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ClearImages.Icon16"/>
                    <bt:Image size="32" resid="ClearImages.Icon32"/>
                    <bt:Image size="80" resid="ClearImages.Icon80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>clearImages</FunctionName>
                  </Action>
                </Control>
              </Group>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>

        <!-- Web: same minimal commands -->
        <WebFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="BulkImageImporter.Tab.Web">
              <Label resid="Tab.Label"/>
              <Group id="BulkImageImporter.Group.Main.Web">
                <Label resid="MainGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="MainGroup.Icon16"/>
                  <bt:Image size="32" resid="MainGroup.Icon32"/>
                  <bt:Image size="80" resid="MainGroup.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="BulkImageImporter.Button.Open.Web">
                  <Label resid="OpenImporter.Label"/>
                  <Supertip>
                    <Title resid="OpenImporter.Label"/>
                    <Description resid="OpenImporter.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="OpenImporter.Icon16"/>
                    <bt:Image size="32" resid="OpenImporter.Icon32"/>
                    <bt:Image size="80" resid="OpenImporter.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BulkImageImporter.Button.Clear.Web">
                  <Label resid="ClearImages.Label"/>
                  <Supertip>
                    <Title resid="ClearImages.Label"/>
                    <Description resid="ClearImages.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ClearImages.Icon16"/>
                    <bt:Image size="32" resid="ClearImages.Icon32"/>
                    <bt:Image size="80" resid="ClearImages.Icon80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>clearImages</FunctionName>
                  </Action>
                </Control>
              </Group>
            </CustomTab>
          </ExtensionPoint>
        </WebFormFactor>

      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="MainGroup.Icon16" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/group-import-16.png"/>
        <bt:Image id="MainGroup.Icon32" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/group-import-32.png"/>
        <bt:Image id="MainGroup.Icon80" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/group-import-80.png"/>
        <bt:Image id="OpenImporter.Icon16" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/import-images-16.png"/>
        <bt:Image id="OpenImporter.Icon32" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/import-images-32.png"/>
        <bt:Image id="OpenImporter.Icon80" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/import-images-80.png"/>
        <bt:Image id="ClearImages.Icon16" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/clear-images-16.png"/>
        <bt:Image id="ClearImages.Icon32" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/clear-images-32.png"/>
        <bt:Image id="ClearImages.Icon80" DefaultValue="https://bulk-image-importer-pro.pages.dev/assets/icons/clear-images-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://bulk-image-importer-pro.pages.dev/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://bulk-image-importer-pro.pages.dev/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Tab.Label" DefaultValue="Image Tools"/>
        <bt:String id="MainGroup.Label" DefaultValue="Importer"/>
        <bt:String id="OpenImporter.Label" DefaultValue="Open Importer"/>
        <bt:String id="ClearImages.Label" DefaultValue="Clear Images"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="OpenImporter.Description" DefaultValue="Open the Bulk Image Importer task pane to import images with advanced layouts"/>
        <bt:String id="ClearImages.Description" DefaultValue="Remove all imported images from all worksheets"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
