      <bt:LongStrings>
        <bt:String id="ImportImages.Description" DefaultValue="Select multiple image files to import into the current worksheet"/>
        <bt:String id="ImportFolder.Description" DefaultValue="Import all images from a selected folder"/>
        <bt:String id="ImportRow.Description" DefaultValue="Import images arranged horizontally in a single row"/>
        <bt:String id="ImportColumn.Description" DefaultValue="Import images arranged vertically in a single column"/>
        <bt:String id="ImportGrid.Description" DefaultValue="Import images in a grid layout with configurable columns"/>
        <bt:String id="ImportContactSheet.Description" DefaultValue="Generate a professional contact sheet with thumbnails and metadata"/>
        <bt:String id="ClearImages.Description" DefaultValue="Remove all imported images from all worksheets"/>
