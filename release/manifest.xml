                <Control xsi:type="Button" id="BulkImageImporter.Button.Column">
                  <Label resid="ImportColumn.Label"/>
                  <Supertip>
                    <Title resid="ImportColumn.Label"/>
                    <Description resid="ImportColumn.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ImportColumn.Icon16"/>
                    <bt:Image size="32" resid="ImportColumn.Icon32"/>
                    <bt:Image size="80" resid="ImportColumn.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BulkImageImporter.Button.Grid">
                  <Label resid="ImportGrid.Label"/>
                  <Supertip>
                    <Title resid="ImportGrid.Label"/>
                    <Description resid="ImportGrid.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ImportGrid.Icon16"/>
                    <bt:Image size="32" resid="ImportGrid.Icon32"/>
                    <bt:Image size="80" resid="ImportGrid.Icon80"/>
