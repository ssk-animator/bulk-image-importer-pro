                    <bt:Image size="16" resid="ImportGrid.Icon16"/>
                    <bt:Image size="32" resid="ImportGrid.Icon32"/>
                    <bt:Image size="80" resid="ImportGrid.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>BulkImageImporter.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
